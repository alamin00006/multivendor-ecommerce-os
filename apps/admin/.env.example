# Server-side URL of the NestJS API (used by the /api/v1 rewrite)
API_INTERNAL_URL=http://localhost:4000
# Storefront (apps/web) — used for "View in store" / preview links
NEXT_PUBLIC_STORE_URL=http://localhost:3100

# Chat Socket.IO connects straight to the API (Next rewrites do not proxy WebSockets)
NEXT_PUBLIC_API_ORIGIN=http://localhost:4000

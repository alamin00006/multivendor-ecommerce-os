{
  "name": "marketbd",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @marketbd/api prisma:migrate",
    "db:seed": "pnpm --filter @marketbd/api prisma:seed",
    "db:reset": "pnpm --filter @marketbd/api prisma:reset"
  },
  "devDependencies": {
    "turbo": "^2.11.10",
    "typescript": "~6.0.3"
  }
}

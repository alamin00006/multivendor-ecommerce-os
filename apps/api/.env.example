# ── Server ─────────────────────────────────────────────
NODE_ENV=development
PORT=4000
API_PUBLIC_URL=http://localhost:4000
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3100,http://localhost:3101,http://localhost:8081

# ── Database ───────────────────────────────────────────
DATABASE_URL=postgresql://marketbd:marketbd@localhost:5440/marketbd?schema=public

# Used only by the first seed; afterwards the PlatformSetting row is the source of truth.
MULTI_VENDOR_ENABLED=true

# ── Auth ───────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
# console = print OTP codes to the API log (development). sms = HTTP SMS gateway below.
OTP_PROVIDER=console
SMS_GATEWAY_URL=
SMS_GATEWAY_API_KEY=
SMS_SENDER_ID=MarketBD

# ── Object storage (MinIO / S3) ────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=marketbd
S3_SECRET_KEY=marketbd-secret
S3_BUCKET=marketbd
S3_FORCE_PATH_STYLE=true
# Public base URL that browsers use to fetch stored objects
S3_PUBLIC_URL=http://localhost:9000/marketbd
# Hosts the image-resize endpoint may fetch from (comma-separated)
IMAGE_ALLOWED_HOSTS=localhost:9000,picsum.photos,fastly.picsum.photos

# ── Seed ───────────────────────────────────────────────
SEED_ADMIN_EMAIL=admin@marketbd.example
SEED_ADMIN_PASSWORD=Admin@12345

# ── Frontend URLs (payment redirects) ──────────────────
WEB_URL=http://localhost:3100

# ── bKash tokenized checkout (sandbox) ─────────────────
BKASH_ENABLED=false
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=

# ── SSLCommerz (sandbox) ───────────────────────────────
SSLCOMMERZ_ENABLED=false
SSLCOMMERZ_BASE_URL=https://sandbox.sslcommerz.com
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=

# ── Optional: NestJS Observe telemetry (disabled when unset) ──
OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=

// MarketBD data model. All money columns are integer poisha (1 BDT = 100 poisha).

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// ───────── Enums ─────────

enum Role {
  CUSTOMER
  SELLER
  ADMIN
}

enum SellerStatus {
  PENDING
  APPROVED
  SUSPENDED
}

enum ProductStatus {
  DRAFT
  PENDING_REVIEW
  ACTIVE
  INACTIVE
  REJECTED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  RETURN_REQUESTED
  RETURNED
  REFUNDED
}

enum PaymentMethod {
  COD
  BKASH
  SSLCOMMERZ
  /// Paid in cash at the store counter (POS).
  CASH
}

/// Where an order was taken.
enum OrderChannel {
  ONLINE
  POS
}

enum PaymentStatus {
  UNPAID
  PENDING
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

/// Courier companies the platform books parcels with.
enum CourierProvider {
  PATHAO
  STEADFAST
}

/// A courier the platform books with, configured by the admin (Admin → Couriers).
model CourierAccount {
  provider      CourierProvider @id
  enabled       Boolean         @default(false)
  sandbox       Boolean         @default(false)
  /// AES-256-GCM encrypted JSON of the courier's credentials.
  credentials   String?
  /// Secret the courier sends with each webhook (header or bearer token).
  webhookSecret String
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

/// Who delivers a package: the platform's couriers, or the shop with its own courier.
enum Fulfillment {
  PLATFORM
  SELLER
}

/// A shop's request to deliver with its own courier.
enum OwnDeliveryStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ShippingZone {
  INSIDE_DHAKA
  OUTSIDE_DHAKA
}

enum CouponType {
  PERCENTAGE
  FIXED
  /// Discount on the delivery fee; `value` caps it (0 = the whole fee).
  FREE_SHIPPING
}

/// Who funds the voucher and where it applies.
enum CouponScope {
  /// Whole order, funded by the platform.
  PLATFORM
  /// One shop's items, funded by that seller.
  STORE
  /// Whole order, only when paid with `paymentMethod`.
  PAYMENT
}

enum CampaignType {
  MEGA_SALE
  BRAND_DAY
  CATEGORY_SALE
  SEASONAL
}

enum LinkTargetType {
  CATEGORY
  CAMPAIGN
  PRODUCT
  BRAND
  SEARCH
  EXTERNAL
}

enum BannerPlacement {
  HOME_HERO
  HOME_MID
  CATEGORY_TOP
}

enum OtpPurpose {
  LOGIN
  VERIFY_PHONE
  RESET_PASSWORD
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  RECEIVED
  REFUNDED
}

enum RefundStatus {
  PENDING
  COMPLETED
  FAILED
}

enum PayoutStatus {
  REQUESTED
  PAID
  REJECTED
}

enum PayoutMethod {
  BKASH
  NAGAD
  BANK
}

enum NotificationType {
  ORDER
  PAYMENT
  PROMO
  SYSTEM
  SELLER
  CHAT
}

enum ChatSide {
  CUSTOMER
  SELLER
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum Locale {
  EN
  BN
}

enum AddressLabel {
  HOME
  OFFICE
  OTHER
}

// ───────── Platform ─────────

model PlatformSetting {
  id                   Int      @id @default(1)
  multiVendorEnabled   Boolean  @default(true)
  // Delivery (fees in poisha) — used by checkout and shown on product pages
  shippingInsideDhaka  Int      @default(6000)
  shippingOutsideDhaka Int      @default(12000)
  deliveryInsideDhaka  String   @default("1–2 days")
  deliveryOutsideDhaka String   @default("3–5 days")
  // Returns
  returnDays           Int      @default(7)
  returnPolicy         String   @default("Unused items in original packaging can be returned within the return window.")
  // Store contact info (footer, help pages)
  storeAddress         String   @default("House 1, Road 1, Gulshan 1, Dhaka 1212, Bangladesh")
  supportPhone         String   @default("+8809600000000")
  supportEmail         String   @default("support@marketbd.example")
  supportHours         String   @default("9 am – 9 pm (Everyday)")
  socialLinks          Json     @default("{}")
  /// Brand colours (hex): primary = shade 700, accent = shade 500.
  brandPrimary         String   @default("#08755a")
  brandAccent          String   @default("#f55a36")
  /// Most a shop delivering COD with its own courier may owe in commission before COD is paused (poisha).
  ownDeliveryDueLimit  Int      @default(500000)
  updatedById          String?
  updatedAt            DateTime @updatedAt
}

// ───────── Users & auth ─────────

model User {
  id              String    @id @default(cuid())
  email           String?   @unique
  phone           String?   @unique
  passwordHash    String?
  name            String
  avatarUrl       String?
  role            Role      @default(CUSTOMER)
  locale          Locale    @default(EN)
  /// Date only (no time zone shifts).
  birthday        DateTime? @db.Date
  gender          Gender?
  isActive        Boolean   @default(true)
  /// Admin staff areas (see ADMIN_AREAS in @marketbd/shared); "all" = owner. Empty for other roles.
  adminPermissions String[] @default([])
  emailVerifiedAt DateTime?
  phoneVerifiedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  sellerProfile     SellerProfile?
  addresses         Address[]
  refreshTokens     RefreshToken[]
  cart              Cart?
  wishlist          Wishlist[]
  orders            Order[]
  reviews           Review[]
  questions         ProductQuestion[]  @relation("QuestionAsker")
  answers           ProductQuestion[]  @relation("QuestionAnswerer")
  conversations     Conversation[]     @relation("ChatCustomer")
  chatMessages      ChatMessage[]      @relation("ChatSender")
  notifications     Notification[]
  pushTokens        PushToken[]
  couponRedemptions CouponRedemption[]
  couponCollections CouponCollection[]
  adminActivities   AdminActivity[]

  @@index([role, createdAt])
}

/// Every change an admin makes through the API (who, what, when). Read-only in the panel.
model AdminActivity {
  id        String   @id @default(cuid())
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  method    String
  path      String
  area      String
  summary   String?
  /// Request body with secrets stripped.
  details   Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([area, createdAt])
}

model RefreshToken {
  id           String    @id @default(cuid())
  userId       String
  tokenHash    String    @unique
  familyId     String
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?
  userAgent    String?
  ip           String?
  createdAt    DateTime  @default(now())
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
}

model OtpCode {
  id         String     @id @default(cuid())
  phone      String
  codeHash   String
  purpose    OtpPurpose
  attempts   Int        @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime   @default(now())

  @@index([phone, purpose, createdAt])
}

// ───────── Bangladesh geography ─────────

model Division {
  id        Int        @id
  name      String
  nameBn    String
  districts District[]
  addresses Address[]
}

model District {
  id         Int       @id
  divisionId Int
  name       String
  nameBn     String
  division   Division  @relation(fields: [divisionId], references: [id])
  areas      Area[]
  addresses  Address[]

  @@index([divisionId])
}

model Area {
  id            Int       @id @default(autoincrement())
  districtId    Int
  name          String
  nameBn        String
  isInsideDhaka Boolean   @default(false)
  district      District  @relation(fields: [districtId], references: [id])
  addresses     Address[]

  @@unique([districtId, name])
}

model Address {
  id          String       @id @default(cuid())
  userId      String
  label       AddressLabel @default(HOME)
  fullName    String
  phone       String
  divisionId  Int
  districtId  Int
  areaId      Int
  addressLine String
  landmark    String?
  isDefault   Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  division    Division     @relation(fields: [divisionId], references: [id])
  district    District     @relation(fields: [districtId], references: [id])
  area        Area         @relation(fields: [areaId], references: [id])

  @@index([userId])
}

// ───────── Sellers ─────────

model SellerProfile {
  id             String         @id @default(cuid())
  userId         String         @unique
  shopName       String
  slug           String         @unique
  logoUrl        String?
  bannerUrl      String?
  description    String?
  phone          String?
  pickupAddress  String?
  status         SellerStatus   @default(PENDING)
  isHouseStore   Boolean        @default(false)
  commissionRate Decimal        @default(10) @db.Decimal(5, 2)
  ratingAvg      Decimal        @default(0) @db.Decimal(2, 1)
  approvedAt     DateTime?
  /// Where payouts go: { method, accountName, accountNumber, bankName?, branch? }
  payoutAccount  Json?
  /// Own-courier settings: { courier, courierName?, insideDhakaFee, outsideDhakaFee, insideDhakaEta, outsideDhakaEta }
  ownDelivery           Json?
  /// Null = MarketBD Delivery. APPROVED = the shop delivers its own packages.
  ownDeliveryStatus     OwnDeliveryStatus?
  /// Admin's note on the last decision (shown to the seller).
  ownDeliveryNote       String?
  ownDeliveryUpdatedAt  DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  user           User           @relation(fields: [userId], references: [id])
  products       Product[]
  subOrders      SubOrder[]
  adjustments    SellerAdjustment[]
  courierAccounts SellerCourierAccount[]
  conversations  Conversation[]
  coupons        Coupon[]
  payouts        Payout[]
  courierStores  CourierStore[]

  @@index([status])
}

/// A seller's pickup point registered with a courier under the platform's courier account.
/// The courier's rider collects that seller's parcels from this address.
model CourierStore {
  id              String          @id @default(cuid())
  sellerId        String
  provider        CourierProvider
  /// The courier's store id. Null until the courier lists the new store (approval can take ~1 hour).
  externalId      String?
  name            String
  contactName     String
  contactNumber   String
  address         String
  cityId          Int
  zoneId          Int
  areaId          Int
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  seller          SellerProfile   @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@unique([sellerId, provider])
}

/// Money paid out to a seller from their cleared earnings.
model Payout {
  id            String        @id @default(cuid())
  sellerId      String
  amount        Int
  status        PayoutStatus  @default(REQUESTED)
  method        PayoutMethod
  accountName   String
  accountNumber String
  bankName      String?
  branch        String?
  sellerNote    String?
  adminNote     String?
  /// Transaction id / bank reference entered by admin when paid.
  reference     String?
  processedById String?
  processedAt   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  seller        SellerProfile @relation(fields: [sellerId], references: [id])

  @@index([sellerId, createdAt])
  @@index([status, createdAt])
}

// ───────── Catalog ─────────

model Category {
  id         String     @id @default(cuid())
  parentId   String?
  name       String
  nameBn     String
  slug       String     @unique
  iconUrl    String?
  imageUrl   String?
  sortOrder  Int        @default(0)
  isActive   Boolean    @default(true)
  /// Markdown shown below the product grid on the category page (buying guide, FAQ…)
  seoContent String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  parent     Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children   Category[] @relation("CategoryTree")
  products   Product[]

  @@index([parentId, sortOrder])
}

model Brand {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique
  logoUrl   String?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]
}

model Product {
  id             String                   @id @default(cuid())
  sellerId       String
  categoryId     String
  brandId        String?
  title          String
  titleBn        String?
  slug           String                   @unique
  description    String
  descriptionBn  String?
  status         ProductStatus            @default(DRAFT)
  minPrice       Int                      @default(0)
  ratingAvg      Decimal                  @default(0) @db.Decimal(2, 1)
  ratingCount    Int                      @default(0)
  soldCount      Int                      @default(0)
  searchVector   Unsupported("tsvector")?
  /// Key features shown as bullets on the product page
  highlights     String[]                 @default([])
  /// [{ "label": "Battery", "value": "5000 mAh" }, …]
  specifications Json                     @default("[]")
  warranty       String?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  seller         SellerProfile            @relation(fields: [sellerId], references: [id])
  category       Category                 @relation(fields: [categoryId], references: [id])
  brand          Brand?                   @relation(fields: [brandId], references: [id])
  variants       ProductVariant[]
  images         ProductImage[]
  reviews        Review[]
  questions      ProductQuestion[]
  chatMessages   ChatMessage[]
  wishlistedBy   Wishlist[]
  campaigns      CampaignProduct[]
  orderItems     OrderItem[]

  @@index([sellerId, status])
  @@index([categoryId, status, minPrice])
  @@index([brandId])
  @@index([status, soldCount])
  @@index([status, createdAt])
  @@index([searchVector], type: Gin, map: "Product_searchVector_idx")
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin, map: "Product_title_trgm_idx")
}

model ProductVariant {
  id             String          @id @default(cuid())
  productId      String
  sku            String          @unique
  attributes     Json
  price          Int
  compareAtPrice Int?
  stock          Int             @default(0)
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  product        Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  images         ProductImage[]
  cartItems      CartItem[]
  orderItems     OrderItem[]
  flashSaleItems FlashSaleItem[]

  @@index([productId])
}

model ProductImage {
  id        String          @id @default(cuid())
  productId String
  variantId String?
  url       String
  alt       String?
  sortOrder Int             @default(0)
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([productId, sortOrder])
}

// ───────── Cart & wishlist ─────────

model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
}

model CartItem {
  id        String         @id @default(cuid())
  cartId    String
  variantId String
  quantity  Int
  selected  Boolean        @default(true)
  addedAt   DateTime       @default(now())
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([cartId, variantId])
}

model Wishlist {
  userId    String
  productId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([userId, productId])
}

// ───────── Orders ─────────

model Order {
  id              String               @id @default(cuid())
  orderNumber     String               @unique
  userId          String
  status          OrderStatus          @default(PENDING)
  paymentMethod   PaymentMethod
  paymentStatus   PaymentStatus        @default(UNPAID)
  channel         OrderChannel         @default(ONLINE)
  shippingZone    ShippingZone
  shippingAddress Json
  subtotal        Int
  shippingFee     Int
  discount        Int                  @default(0)
  total           Int
  couponId        String?
  couponCode      String?
  note            String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  user            User                 @relation(fields: [userId], references: [id])
  coupon          Coupon?              @relation(fields: [couponId], references: [id])
  subOrders       SubOrder[]
  items           OrderItem[]
  payments        Payment[]
  history         OrderStatusHistory[]
  returns         ReturnRequest[]
  redemption      CouponRedemption?

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([channel, createdAt])
}

model SubOrder {
  id               String               @id @default(cuid())
  orderId          String
  sellerId         String
  status           OrderStatus          @default(PENDING)
  subtotal         Int
  shippingFee      Int
  discount         Int                  @default(0)
  total            Int
  commissionRate   Decimal              @db.Decimal(5, 2)
  commissionAmount Int
  trackingNumber   String?
  /// Who delivers this package (fixed when the order is placed).
  fulfillment        Fulfillment        @default(PLATFORM)
  /// Shop's courier for SELLER fulfilment, e.g. "Steadfast" or "Own rider".
  courierName        String?
  /// COD package delivered by the shop: the courier pays the cash to the shop, not the platform.
  sellerCollectsCash Boolean            @default(false)
  /// Customer said the parcel never arrived.
  disputeNote        String?
  disputedAt         DateTime?
  /// DELIVERED (complaint rejected) or NOT_DELIVERED (customer is right), set by admin.
  disputeResolution  String?
  disputeResolvedAt  DateTime?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  order            Order                @relation(fields: [orderId], references: [id], onDelete: Cascade)
  seller           SellerProfile        @relation(fields: [sellerId], references: [id])
  items            OrderItem[]
  history          OrderStatusHistory[]
  returns          ReturnRequest[]
  shipments        Shipment[]

  @@unique([orderId, sellerId])
  @@index([sellerId, status, createdAt])
}

/// A courier booking for one package (sub-order). A package can be booked again after the courier cancels the pickup.
model Shipment {
  id              String          @id @default(cuid())
  subOrderId      String
  provider        CourierProvider
  consignmentId   String
  /// Our reference sent to the courier; unique per booking.
  merchantOrderId String          @unique
  /// Customer-facing tracking code when the courier has one separate from the consignment id.
  trackingCode    String?
  /// Courier store the parcel is collected from; null for couriers without per-seller stores.
  storeExternalId String?
  /// Last courier status or webhook event, e.g. "order.picked" or "Delivered".
  courierStatus   String
  /// False once the courier cancelled the pickup; a new booking can then be made.
  active          Boolean         @default(true)
  /// Cash the rider collects, in poisha.
  codAmount       Int
  deliveryFee     Int?
  collectedAmount Int?
  /// Courier-side time of the last applied update, used to ignore out-of-order webhooks.
  courierUpdatedAt DateTime?
  /// Shop whose own courier account the parcel was booked on; null = the platform's account.
  accountSellerId  String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  subOrder        SubOrder        @relation(fields: [subOrderId], references: [id], onDelete: Cascade)

  @@unique([provider, consignmentId])
  @@index([subOrderId])
  @@index([active, updatedAt])
}

model OrderItem {
  id              String         @id @default(cuid())
  orderId         String
  subOrderId      String
  productId       String
  variantId       String
  title           String
  variantLabel    String
  sku             String
  imageUrl        String?
  unitPrice       Int
  quantity        Int
  lineTotal       Int
  flashSaleItemId String?
  order           Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  subOrder        SubOrder       @relation(fields: [subOrderId], references: [id], onDelete: Cascade)
  product         Product        @relation(fields: [productId], references: [id])
  variant         ProductVariant @relation(fields: [variantId], references: [id])
  flashSaleItem   FlashSaleItem? @relation(fields: [flashSaleItemId], references: [id])
  review          Review?

  @@index([orderId])
  @@index([subOrderId])
}

model OrderStatusHistory {
  id         String       @id @default(cuid())
  orderId    String
  subOrderId String?
  fromStatus OrderStatus?
  toStatus   OrderStatus
  note       String?
  actorId    String?
  createdAt  DateTime     @default(now())
  order      Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  subOrder   SubOrder?    @relation(fields: [subOrderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
}

model ReturnRequest {
  id         String       @id @default(cuid())
  orderId    String
  subOrderId String?
  reason     String
  imageUrls  String[]
  status     ReturnStatus @default(REQUESTED)
  adminNote  String?
  sellerNote String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  order      Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  subOrder   SubOrder?    @relation(fields: [subOrderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([status, createdAt])
}

// ───────── Payments ─────────

model Payment {
  id           String        @id @default(cuid())
  orderId      String
  method       PaymentMethod
  status       PaymentStatus @default(PENDING)
  amount       Int
  gatewayRef   String?       @unique
  gatewayTrxId String?
  rawResponse  Json?
  paidAt       DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  order        Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  refunds      Refund[]

  @@index([orderId])
}

model Refund {
  id          String       @id @default(cuid())
  paymentId   String
  amount      Int
  reason      String
  status      RefundStatus @default(PENDING)
  gatewayRef  String?
  createdById String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  payment     Payment      @relation(fields: [paymentId], references: [id])

  @@index([paymentId])
}

// ───────── Reviews ─────────

model Review {
  id                 String        @id @default(cuid())
  productId          String
  userId             String
  orderItemId        String?       @unique
  rating             Int
  comment            String?
  isVerifiedPurchase Boolean       @default(false)
  isVisible          Boolean       @default(true)
  sellerReply        String?
  sellerRepliedAt    DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  product            Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  user               User          @relation(fields: [userId], references: [id])
  orderItem          OrderItem?    @relation(fields: [orderItemId], references: [id])
  images             ReviewImage[]

  @@unique([userId, productId])
  @@index([productId, createdAt])
}

model ReviewImage {
  id       String @id @default(cuid())
  reviewId String
  url      String
  review   Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
}

// ───────── Coupons ─────────

model Coupon {
  id             String             @id @default(cuid())
  code           String             @unique
  description    String?
  type           CouponType
  value          Int
  minOrderAmount Int                @default(0)
  maxDiscount    Int?
  usageLimit     Int?
  perUserLimit   Int                @default(1)
  usedCount      Int                @default(0)
  startsAt       DateTime
  endsAt         DateTime
  isActive       Boolean            @default(true)
  scope          CouponScope        @default(PLATFORM)
  /// Set for STORE vouchers.
  sellerId       String?
  /// Set for PAYMENT vouchers.
  paymentMethod  PaymentMethod?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  seller         SellerProfile?     @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  orders         Order[]
  redemptions    CouponRedemption[]
  collections    CouponCollection[]

  @@index([isActive, endsAt])
  @@index([sellerId])
}

/// A voucher saved to a customer's wallet ("Collect").
model CouponCollection {
  userId    String
  couponId  String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  coupon    Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)

  @@id([userId, couponId])
  @@index([couponId])
}

model CouponRedemption {
  id        String   @id @default(cuid())
  couponId  String
  userId    String
  orderId   String   @unique
  createdAt DateTime @default(now())
  coupon    Coupon   @relation(fields: [couponId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([couponId, userId])
}

// ───────── Merchandising ─────────

model Campaign {
  id              String            @id @default(cuid())
  slug            String            @unique
  title           String
  titleBn         String?
  description     String?
  bannerUrl       String
  mobileBannerUrl String?
  themeColor      String?
  type            CampaignType
  startAt         DateTime
  endAt           DateTime
  isActive        Boolean           @default(true)
  sortOrder       Int               @default(0)
  /// Terms & conditions shown on the campaign page, one rule per item.
  terms           String[]          @default([])
  /// Voucher codes promoted on the campaign page ("Collect Voucher & Enjoy Discount").
  voucherCodes    String[]          @default([])
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  products        CampaignProduct[]

  @@index([isActive, startAt, endAt])
}

model CampaignProduct {
  campaignId String
  productId  String
  sortOrder  Int      @default(0)
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([campaignId, productId])
}

model FlashSale {
  id        String          @id @default(cuid())
  title     String
  titleBn   String?
  startAt   DateTime
  endAt     DateTime
  isActive  Boolean         @default(true)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  items     FlashSaleItem[]

  @@index([isActive, startAt, endAt])
}

model FlashSaleItem {
  id           String         @id @default(cuid())
  flashSaleId  String
  variantId    String
  specialPrice Int
  stockLimit   Int
  soldCount    Int            @default(0)
  sortOrder    Int            @default(0)
  flashSale    FlashSale      @relation(fields: [flashSaleId], references: [id], onDelete: Cascade)
  variant      ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  orderItems   OrderItem[]

  @@unique([flashSaleId, variantId])
}

model Banner {
  id             String          @id @default(cuid())
  title          String
  imageUrl       String
  mobileImageUrl String?
  placement      BannerPlacement @default(HOME_HERO)
  linkType       LinkTargetType
  linkValue      String
  sortOrder      Int             @default(0)
  isActive       Boolean         @default(true)
  startAt        DateTime?
  endAt          DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([placement, isActive, sortOrder])
}

model QuickLink {
  id        String         @id @default(cuid())
  label     String
  labelBn   String
  iconUrl   String
  linkType  LinkTargetType
  linkValue String
  sortOrder Int            @default(0)
  isActive  Boolean        @default(true)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  data      Json?
  readAt    DateTime?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
}

/// Expo push token of a signed-in app install (one row per device).
model PushToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  platform  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ───────── Product Q&A ─────────

model ProductQuestion {
  id           String    @id @default(cuid())
  productId    String
  userId       String
  question     String
  answer       String?
  answeredById String?
  answeredAt   DateTime?
  isVisible    Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  product      Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  user         User      @relation("QuestionAsker", fields: [userId], references: [id], onDelete: Cascade)
  answeredBy   User?     @relation("QuestionAnswerer", fields: [answeredById], references: [id], onDelete: SetNull)

  @@index([productId, isVisible, createdAt])
  @@index([answeredAt])
}

// ───────── Customer ↔ seller chat ─────────

/// One thread per customer and shop. Unread counters and read pointers are kept per side.
model Conversation {
  id                 String        @id @default(cuid())
  customerId         String
  sellerId           String
  lastMessageAt      DateTime      @default(now())
  lastMessagePreview String        @default("")
  lastMessageSide    ChatSide?
  customerUnread     Int           @default(0)
  sellerUnread       Int           @default(0)
  customerLastReadAt DateTime?
  sellerLastReadAt   DateTime?
  createdAt          DateTime      @default(now())
  customer           User          @relation("ChatCustomer", fields: [customerId], references: [id], onDelete: Cascade)
  seller             SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  messages           ChatMessage[]

  @@unique([customerId, sellerId])
  @@index([customerId, lastMessageAt])
  @@index([sellerId, lastMessageAt])
}

model ChatMessage {
  id             String       @id @default(cuid())
  conversationId String
  senderId       String
  side           ChatSide
  body           String
  /// Product the message is about (shared from a product page).
  productId      String?
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation("ChatSender", fields: [senderId], references: [id], onDelete: Cascade)
  product        Product?     @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([conversationId, createdAt])
}

/// Manual balance change for a seller, e.g. commission dues the seller paid to the platform (positive amount).
model SellerAdjustment {
  id          String        @id @default(cuid())
  sellerId    String
  /// Poisha; positive adds to the seller's balance, negative takes from it.
  amount      Int
  note        String
  reference   String?
  createdById String
  createdAt   DateTime      @default(now())
  seller      SellerProfile @relation(fields: [sellerId], references: [id])

  @@index([sellerId, createdAt])
}

/// A shop's own courier account (own delivery): parcels are booked on the shop's account and the
/// courier reports status to the shop's own webhook URL. Credentials are stored encrypted.
model SellerCourierAccount {
  sellerId        String
  provider        CourierProvider
  enabled         Boolean       @default(false)
  sandbox         Boolean       @default(false)
  /// AES-256-GCM encrypted JSON of the courier's credentials.
  credentials     String?
  webhookSecret   String
  /// The shop's pickup store id at the courier (couriers with per-shop stores, e.g. Pathao).
  storeExternalId String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  seller          SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@id([sellerId, provider])
}
